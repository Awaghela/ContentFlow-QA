# ── Database ──────────────────────────────────────────────────────────────────
# Docker Compose uses the service name "db" as the host
DATABASE_URL=postgresql+asyncpg://contentflow:password@db:5432/contentflow_qa
POSTGRES_USER=contentflow
POSTGRES_PASSWORD=password
POSTGRES_DB=contentflow_qa

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# ── FFmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ── Validation ────────────────────────────────────────────────────────────────
MAX_WORKERS=4
REQUEST_TIMEOUT=10
MAX_FILE_SIZE_MB=5000
